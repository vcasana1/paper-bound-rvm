/-! ### The integral -/

lemma hR : (0 : ℝ) < 1 := one_pos
lemma h1 : (1 : ℝ) - 1 ≤ 1 / 2 := by norm_num
lemma h2 : (1 : ℝ) ≤ 1 + 1 := by norm_num
