        + (0 - s7) * ((1 - 1 - 1) * (π - θb 1 1 1) + 1 * sin (θb 1 1 1))) := by
  simp only [gB]
  rw [integral_add, integral_add, integral_add, integral_add, integral_add, integral_add, integral_add, integral_add, integral_add, integral_add]
  · simp only [integral_const_mul, integral_const, smul_eq_mul]
    rw [integral_half, integral_lin', int_max_b hR h2 h3 (a := 139/194) (by norm_num) (by norm_num),
      int_max_b hR h2 h3 (a := 173/207) (by norm_num) (by norm_num),
