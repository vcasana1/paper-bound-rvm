/-- `∫₀^π 𝔢_B^*(1 + cos θ) dθ` in closed form. -/
theorem integral_eBStar_eq :
    ∫ θ in (0 : ℝ)..π, eBStar (1 + cos θ)
      = (13/84 * θh 1 1 + s0 * ((1 - 1 / 2) * θh 1 1 + 1 * sin (θh 1 1))
        + (s1 - s0) * ((1 - 139/194) * θa 1 1 (139/194) + 1 * sin (θa 1 1 (139/194)))
        + (s2 - s1) * ((1 - 173/207) * θa 1 1 (173/207) + 1 * sin (θa 1 1 (173/207)))
        + (s3 - s2) * ((1 - 773/854) * θa 1 1 (773/854) + 1 * sin (θa 1 1 (773/854)))
        + (s4 - s3) * ((1 - 820/867) * θa 1 1 (820/867) + 1 * sin (θa 1 1 (820/867)))
        + (s5 - s4) * ((1 - 3387/3494) * θa 1 1 (3387/3494) + 1 * sin (θa 1 1 (3387/3494)))
        + (s6 - s5) * ((1 - 1149/1169) * θa 1 1 (1149/1169) + 1 * sin (θa 1 1 (1149/1169)))
        + (s7 - s6) * ((1 - 13921/14054) * θa 1 1 (13921/14054) + 1 * sin (θa 1 1 (13921/14054)))
        + (0 - s7) * ((1 - 1) * θa 1 1 1 + 1 * sin (θa 1 1 1)))
      + ((1 / 2 - 1) * (π - θh 1 1) + 1 * sin (θh 1 1)
        + (13/84 * (π - θh 1 1) + s0 * ((1 / 2 - 1) * (π - θh 1 1) + 1 * sin (θh 1 1))
        + (s1 - s0) * ((1 - 1 - 139/194) * (π - θb 1 1 (139/194)) + 1 * sin (θb 1 1 (139/194)))
        + (s2 - s1) * ((1 - 1 - 173/207) * (π - θb 1 1 (173/207)) + 1 * sin (θb 1 1 (173/207)))
        + (s3 - s2) * ((1 - 1 - 773/854) * (π - θb 1 1 (773/854)) + 1 * sin (θb 1 1 (773/854)))
        + (s4 - s3) * ((1 - 1 - 820/867) * (π - θb 1 1 (820/867)) + 1 * sin (θb 1 1 (820/867)))
        + (s5 - s4) * ((1 - 1 - 3387/3494) * (π - θb 1 1 (3387/3494)) + 1 * sin (θb 1 1 (3387/3494)))
        + (s6 - s5) * ((1 - 1 - 1149/1169) * (π - θb 1 1 (1149/1169)) + 1 * sin (θb 1 1 (1149/1169)))
        + (s7 - s6) * ((1 - 1 - 13921/14054) * (π - θb 1 1 (13921/14054)) + 1 * sin (θb 1 1 (13921/14054)))
        + (0 - s7) * ((1 - 1 - 1) * (π - θb 1 1 1) + 1 * sin (θb 1 1 1)))) := by
  have hI : ∀ α β : ℝ, IntervalIntegrable (fun θ => eBStar (1 + 1 * cos θ)) MeasureTheory.volume α β :=
    fun α β => (eBStar_continuous.comp (by fun_prop)).intervalIntegrable α β
  have e1 : (fun θ => eBStar (1 + cos θ)) = fun θ => eBStar (1 + 1 * cos θ) := by
    funext θ; rw [one_mul]
  rw [e1, ← integral_add_adjacent_intervals (hI 0 (θh 1 1)) (hI (θh 1 1) π),
    integral_congr (fun θ hθ => eBStar_left hθ), integral_congr (fun θ hθ => eBStar_right hθ),
    integral_left, integral_right]

