lemma eBStar_left {θ : ℝ} (hθ : θ ∈ Set.uIcc 0 (θh 1 1)) :
    eBStar (1 + 1 * cos θ) = gB (1 + 1 * cos θ) := by
  rw [Set.uIcc_of_le θh_nonneg] at hθ
  have h := cos_le_cos_of_nonneg_of_le_pi hθ.1 θh_le_pi hθ.2
  rw [cos_θh hR h1 h2] at h
  unfold eBStar
  split_ifs with hs
  · have : 1 + 1 * cos θ = 1 / 2 := by norm_num at h hs ⊢; linarith
    rw [this]; norm_num
  · rfl

lemma eBStar_right {θ : ℝ} (hθ : θ ∈ Set.uIcc (θh 1 1) π) :
    eBStar (1 + 1 * cos θ) = 1 / 2 - (1 + 1 * cos θ) + gB (1 - (1 + 1 * cos θ)) := by
  rw [Set.uIcc_of_le θh_le_pi] at hθ
  have h := cos_le_cos_of_nonneg_of_le_pi θh_nonneg hθ.2 hθ.1
  rw [cos_θh hR h1 h2] at h
  unfold eBStar
  rw [if_pos (by norm_num at h ⊢; linarith)]

lemma integral_left :
    ∫ θ in (0 : ℝ)..θh 1 1, gB (1 + 1 * cos θ)
      = 13/84 * θh 1 1 + s0 * ((1 - 1 / 2) * θh 1 1 + 1 * sin (θh 1 1))
        + (s1 - s0) * ((1 - 139/194) * θa 1 1 (139/194) + 1 * sin (θa 1 1 (139/194)))
        + (s2 - s1) * ((1 - 173/207) * θa 1 1 (173/207) + 1 * sin (θa 1 1 (173/207)))
        + (s3 - s2) * ((1 - 773/854) * θa 1 1 (773/854) + 1 * sin (θa 1 1 (773/854)))
        + (s4 - s3) * ((1 - 820/867) * θa 1 1 (820/867) + 1 * sin (θa 1 1 (820/867)))
        + (s5 - s4) * ((1 - 3387/3494) * θa 1 1 (3387/3494) + 1 * sin (θa 1 1 (3387/3494)))
        + (s6 - s5) * ((1 - 1149/1169) * θa 1 1 (1149/1169) + 1 * sin (θa 1 1 (1149/1169)))
        + (s7 - s6) * ((1 - 13921/14054) * θa 1 1 (13921/14054) + 1 * sin (θa 1 1 (13921/14054)))
        + (0 - s7) * ((1 - 1) * θa 1 1 1 + 1 * sin (θa 1 1 1)) := by
  simp only [gB]
  rw [integral_add, integral_add, integral_add, integral_add, integral_add, integral_add, integral_add, integral_add, integral_add]
  · simp only [integral_const_mul, integral_const, smul_eq_mul]
    rw [integral_lin, int_max_a hR h1 h2 (a := 139/194) (by norm_num) (by norm_num),
      int_max_a hR h1 h2 (a := 173/207) (by norm_num) (by norm_num),
      int_max_a hR h1 h2 (a := 773/854) (by norm_num) (by norm_num),
      int_max_a hR h1 h2 (a := 820/867) (by norm_num) (by norm_num),
      int_max_a hR h1 h2 (a := 3387/3494) (by norm_num) (by norm_num),
      int_max_a hR h1 h2 (a := 1149/1169) (by norm_num) (by norm_num),
      int_max_a hR h1 h2 (a := 13921/14054) (by norm_num) (by norm_num),
      int_max_a hR h1 h2 (a := 1) (by norm_num) (by norm_num), sin_zero]
    ring
  all_goals exact Continuous.intervalIntegrable (by fun_prop) _ _

lemma integral_right :
    ∫ θ in θh 1 1..π, (1 / 2 - (1 + 1 * cos θ) + gB (1 - (1 + 1 * cos θ)))
      = (1 / 2 - 1) * (π - θh 1 1) + 1 * sin (θh 1 1)
